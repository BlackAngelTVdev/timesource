# Modele de configuration du service ntp-mqtt-clock.
#
# Copier ce fichier en .env puis adapter les valeurs :
#   cp .env.example .env
#
# .env n'est jamais versionne (il contient des identifiants) ; ce modele, lui,
# est dans le depot. Les valeurs ci-dessous sont aussi les valeurs par defaut
# du code (src/config.h), donc le service fonctionne sans .env.

# ---- Broker MQTT ----
MQTT_HOST=mqqt.blue.section-inf.ch
MQTT_PORT=1883
MQTT_USERNAME=ict
MQTT_PASSWORD=321
# Le topic doit etre autorise par l'ACL du broker : sur un topic refuse,
# Mosquitto ferme la connexion.
MQTT_TOPIC=umddcmid3b/dg/time
# Deux instances avec le meme client ID se deconnectent mutuellement.
MQTT_CLIENT_ID=umddcmid3b-dg-time

# ---- Serveur NTP ----
# "none" pour utiliser directement l'horloge systeme.
NTP_SERVER=pool.ntp.org
NTP_SYNC_INTERVAL_MIN=20
NTP_TIMEOUT_MS=3000

# ---- Publication ----
PUBLISH_INTERVAL_MS=1000
